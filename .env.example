# ==========================
# GooUserbot Configuration
# Copy this file to .env and fill the values
# ==========================

# Telegram API (dapatkan di https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Bot Token dari @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Owner & Developer
OWNER_ID=8101612045
DEVS=8101612045 7714463332

# Limit userbot yang bisa dijalankan
MAX_BOT=50

# MongoDB Connection String
MONGO_URL=mongodb://localhost:27017
# atau MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net

# Nama database
NAMA_DB=GooUserbotDB

# Log channels / groups (pisahkan dengan spasi)
LOGS_MAKER_UBOT=-1002864434436
LOGS_ON_UBOT=-1002580967407
BLACKLIST_CHAT=-1002580967407

# Optional: Team IDs
GOO_TEAM=8101612045 7714463332 6642010805
